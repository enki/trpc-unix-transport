{
  "name": "@enki/trpc-unix-transport",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "description": "tRPC transport layer for Unix domain sockets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enki/trpc-unix-transport.git"
  },
  "keywords": [
    "trpc",
    "unix-socket",
    "ipc",
    "transport"
  ],
  "author": "Vibe Team",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "find src -name '*.js' -o -name '*.js.map' -o -name '*.d.ts.map' | xargs rm -f",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0"
  },
  "dependencies": {
    "pino": "^9.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@trpc/client": "11.7.1",
    "@trpc/server": "11.7.1",
    "@types/node": "24.5.2",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": "./src/index.js"
  }
}
